<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_garden_dark"
    android:gravity="center_horizontal"
    android:padding="24dp"
    tools:context=".WaitingRoomActivity">

    <!-- ROOM CODE HEADER -->
    <TextView
        android:id="@+id/roomCodeText"
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="ROOM CODE: ______"
        android:textSize="36sp"
        android:layout_marginBottom="40dp"/>

    <!-- PLAYERS PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginHorizontal="60dp"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/textHostPlayer"
            style="@style/RetroText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOST: WAITING..."
            android:textSize="22sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textGuestPlayer"
            style="@style/RetroText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GUEST: WAITING..."
            android:textSize="22sp" />

    </LinearLayout>

    <!-- START GAME BY HOST (INVISIBLE UNTIL GUEST) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartGame"
        style="@style/RetroButton"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="START GAME"
        android:layout_marginBottom="40dp"
        android:visibility="invisible" />

</LinearLayout>
